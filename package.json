{
  "name": "tree-of-life",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data:life": "python pipeline/import_release.py && node --max-old-space-size=4096 pipeline/build-life.ts",
    "data:life:build": "node --max-old-space-size=4096 pipeline/build-life.ts",
    "data:life:validate": "node --max-old-space-size=4096 pipeline/validate-life.ts",
    "data:build": "node pipeline/build-tree.ts",
    "data:import": "python pipeline/import_opentree.py",
    "data:validate": "python pipeline/import_opentree.py --offline",
    "data:test": "python -m unittest discover -s pipeline -p test_*.py",
    "preview:slow": "node pipeline/preview-network.mjs",
    "predev": "npm run data:build && node pipeline/check-publication.mjs",
    "dev": "vite",
    "prebuild": "npm run data:build",
    "benchmark:build": "node pipeline/benchmark-all.mjs",
    "benchmark:real": "node pipeline/benchmark-real.ts",
    "benchmark:life": "node pipeline/benchmark-life.ts",
    "test": "node --test tests/*.test.ts",
    "build": "node pipeline/check-publication.mjs && npm run build:app",
    "build:app": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/react": "^9.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
