es":[],"ottId":3100720,"scientificName":"Rothschildia jacobaeae","synonyms":[],"wikidata":{"articleTitle":"Rothschildia jacobaeae","articleUrl":"https://en.wikipedia.org/wiki/Rothschildia_jacobaeae","itemId":"Q249186"}},{"commonNames":[],"ottId":3575728,"scientificName":"Troglodiplura lowryi","synonyms":[],"wikidata":{"articleTitle":"Troglodiplura lowryi","articleUrl":"https://en.wikipedia.org/wiki/Troglodiplura_lowryi","itemId":"Q38267"}},{"commonNames":[{"language":"en","name":"Meyer's goshawk","source":"Wikipedia"}],"ottId":3596208,"scientificName":"Accipiter meyerianus","synonyms":[],"wikidata":{"articleTitle":"Meyer's goshawk","articleUrl":"https://en.wikipedia.org/wiki/Meyer's_goshawk","itemId":"Q128039"}},{"commonNames":[{"language":"en","name":"Ololygon ariadne","source":"Wikipedia"}],"ottId":3619760,"scientificName":"Scinax ariadne","synonyms":[],"wikidata":{"articleTitle":"Ololygon ariadne","articleUrl":"https://en.wikipedia.org/wiki/Ololygon_ariadne","itemId":"Q137653"}},{"commonNames":[],"ottId":3636144,"scientificName":"Pseudotropheus minutus","synonyms":[],"wikidata":{"articleTitle":"Pseudotropheus minutus","articleUrl":"https://en.wikipedia.org/wiki/Pseudotropheus_minutus","itemId":"Q139127"}},{"commonNames":[],"ottId":3642288,"scientificName":"Stipecampus cristatus","synonyms":[],"wikidata":{"articleTitle":"Stipecampus cristatus","articleUrl":"https://en.wikipedia.org/wiki/Stipecampus_cristatus","itemId":"Q24931"}},{"commonNames":[],"ottId":3742640,"scientificName":"Lichenostigma","synonyms":[],"wikidata":{"articleTitle":"Lichenostigma","articleUrl":"https://en.wikipedia.org/wiki/Lichenostigma","itemId":"Q93756"}},{"commonNames":[],"facts":[{"kind":"status","label":"Evidence type","source":{"label":"Falk et al., Nature Communications (2017)","url":"https://www.nature.com/articles/ncomms14779"},"value":"Fossil evidence"},{"kind":"age","label":"Time","source":{"label":"Falk et al., Nature Communications (2017)","url":"https://www.nature.com/articles/ncomms14779"},"value":"about 125–120 million years ago"},{"kind":"trait","label":"Flight · A shorter, more integrated body","source":{"label":"Falk et al., Nature Communications (2017)","url":"https://www.nature.com/articles/ncomms14779"},"value":"Confuciusornis shows a bird body becoming more integrated: a toothless beak, a short fused tail, and a shoulder and forelimb devoted more strongly to flight. Long display feathers remained in some individuals."}],"image":{"alt":"Confuciusornis fossil with a compact skeleton and long display feathers","caption":"Confuciusornis combined a short fused tail with long display feathers in some individuals.","credit":"M.violante","license":"CC BY-SA 3.0","sourceUrl":"https://commons.wikimedia.org/wiki/File:Confuciosornis.jpg","src":"images/journeys/birds-flight/confuciusornis.webp"},"ottId":4132144,"scientificName":"Confuciusornis","synonyms":[],"wikipedia":{"extract":"Confuciusornis is a genus of basal crow-sized avialan confuciusornithid theropod dinosaur from the Early Cretaceous Period of the Yixian and Jiufotang Formations of China, dating from 125 to 120 million years ago. Like modern birds, Confuciusornis had a toothless beak, but closer and later relatives of modern birds such as Hesperornis and Ichthyornis were toothed, indicating that the loss of teeth occurred convergently in Confuciusornis and living birds.","revisionId":1368823351,"title":"Confuciusornis","url":"https://en.wikipedia.org/wiki/Confuciusornis","wikidataId":"Q644544"}},{"commonNames":[],"ottId":5922096,"scientificName":"Elatine alsinastrum","synonyms":[],"wikidata":{"articleTitle":"Elatine alsinastrum","articleUrl":"https://en.wikipedia.org/wiki/Elatine_alsinastrum","itemId":"Q160479"}},{"commonNames":[{"language":"en","name":"Humboldt’s Squirrel Monkey","source":"The IUCN Red List of Threatened Species"},{"language":"en","name":"albigena","source":"Catalogue of Life"},{"language":"en","name":"Colombian Squirrel Monkey","source":"Catalogue of Life"},{"language":"en","name":"Humboldt's Squirrel Monkey","source":"Catalogue of Life"},{"language":"en","name":"Colombian Squirrel Monkey (albigena)","source":"Catalogue of Life"}],"gbif":{"canonicalName":"Saimiri cassiquiarensis","confidence":99,"rank":"species","scientificName":"Saimiri cassiquiarensis (Lesson, 1840)","status":"ACCEPTED","usageKey":7576788},"ottId":6145200,"rank":"species","scientificName":"Saimiri cassiquiarensis","synonyms":["Simia sciurea cassiquiarensis"],"wikipedia":{"extract":"Humboldt's squirrel monkey (Saimiri cassiquiarensis) is a species of squirrel monkey from Brazil, Colombia, Ecuador, Peru and Venezuela. It had previously been considered a subspecies of the common squirrel monkey, S. sciureus, but was elevated to full species status based on a genetic study by Carretero-Pinzón in 2009.","revisionId":1356901319,"title":"Humboldt's squirrel monkey","url":"https://en.wikipedia.org/wiki/Humboldt%27s_squirrel_monkey","wikidataId":"Q60607308"}}]}
