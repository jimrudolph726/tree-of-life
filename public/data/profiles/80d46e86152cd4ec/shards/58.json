{"profiles":[{"commonNames":[{"language":"en","name":"Grewcock's sportive lemur","source":"Wikipedia"}],"gbif":{"canonicalName":"Lepilemur manasamody","confidence":98,"rank":"species","scientificName":"Lepilemur manasamody Craul, Zimmermann, Rasoloharijaona, Randrianambinina & Radespiel, 2007","status":"SYNONYM","usageKey":5786420},"ottId":28538,"rank":"species","scientificName":"Lepilemur manasamody","synonyms":[],"wikipedia":{"extract":"Grewcock's sportive lemur (Lepilemur grewcockorum), or the Anjiamangirana sportive lemur, is a sportive lemur endemic to Madagascar. It is a medium-sized sportive lemurs with a total length of about 55 to 63 cm (22 to 25 in), of which 26–30 cm (10–12 in) are tail.","revisionId":1356980933,"title":"Grewcock's sportive lemur","url":"https://en.wikipedia.org/wiki/Grewcock%27s_sportive_lemur","wikidataId":"Q1209776"}},{"commonNames":[{"language":"en","name":"Atelornis Ground-Rollers","source":"Catalogue of Life"},{"language":"en","name":"ground roller","source":"The Paleobiology Database"}],"gbif":{"canonicalName":"Atelornis","confidence":94,"rank":"genus","scientificName":"Atelornis Pucheran, 1846","status":"ACCEPTED","usageKey":2475332},"ottId":372538,"rank":"genus","scientificName":"Atelornis","synonyms":["Coracopitta","Corapitta"],"wikipedia":{"extract":"Atelornis is a small genus of birds in the ground-roller family Brachypteraciidae. The genus is endemic to Madagascar.","revisionId":1309347665,"title":"Atelornis","url":"https://en.wikipedia.org/wiki/Atelornis","wikidataId":"Q628246"}},{"commonNames":[{"language":"en","name":"Crescentchests","source":"Catalogue of Life"},{"language":"en","name":"Crescentchest","source":"Wikipedia"}],"gbif":{"canonicalName":"Melanopareia","confidence":94,"rank":"genus","scientificName":"Melanopareia Reichenbach, 1853","status":"ACCEPTED","usageKey":2491014},"ottId":452474,"rank":"genus","scientificName":"Melanopareia","synonyms":[],"wikipedia":{"extract":"The crescentchests are a genus, Melanoparei