{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-life.example/schemas/scientific-profile-v3.json",
  "title": "Scientific profile shard",
  "type": "object",
  "required": ["profiles"],
  "additionalProperties": false,
  "properties": {
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["ottId", "scientificName", "commonNames", "synonyms"],
      "additionalProperties": false,
      "properties": {
        "ottId": { "type": "integer", "minimum": 1 },
        "scientificName": { "type": "string", "minLength": 1 },
        "rank": { "type": "string", "minLength": 1 },
        "commonNames": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["name", "language", "source"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "language": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        },
        "synonyms": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "gbif": {
          "type": "object",
          "required": ["usageKey", "canonicalName", "scientificName", "rank", "status", "confidence"],
          "additionalProperties": false,
          "properties": {
            "usageKey": { "type": "integer", "minimum": 1 },
            "canonicalName": { "type": "string" },
            "scientificName": { "type": "string" },
            "rank": { "type": "string" },
            "status": { "type": "string" },
            "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "wikipedia": {
          "type": "object",
          "required": ["title", "url", "extract", "revisionId", "wikidataId"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://en\\.wikipedia\\.org/wiki/" },
            "extract": { "type": "string", "minLength": 1 },
            "revisionId": { "type": "integer", "minimum": 1 },
            "wikidataId": { "type": "string", "pattern": "^Q[0-9]+$" }
          }
        },
        "wikidata": {
          "type": "object",
          "required": ["itemId", "articleTitle", "articleUrl"],
          "additionalProperties": false,
          "properties": {
            "itemId": { "type": "string", "pattern": "^Q[0-9]+$" },
            "articleTitle": { "type": "string", "minLength": 1 },
            "articleUrl": { "type": "string", "pattern": "^https://en\\.wikipedia\\.org/wiki/" }
          }
        },
        "conservation": {
          "type": "object",
          "required": ["code", "category", "system", "source"],
          "additionalProperties": false,
          "properties": {
            "code": { "enum": ["EX", "EW", "CR", "EN", "VU", "NT", "LC", "DD"] },
            "category": { "type": "string", "minLength": 1 },
            "system": { "const": "IUCN Red List" },
            "iucnTaxonId": { "type": "string", "pattern": "^[0-9]+(?:_[0-9]+)?$" },
            "source": {
              "type": "object",
              "required": ["label", "url"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "pattern": "^https://api\\.gbif\\.org/" }
              }
            }
          }
        },
        "image": {
          "type": "object",
          "required": ["src", "alt", "caption", "credit", "license", "sourceUrl"],
          "additionalProperties": false,
          "properties": {
            "src": { "type": "string", "pattern": "^images/" },
            "alt": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "minLength": 1 },
            "credit": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "sourceUrl": { "type": "string", "pattern": "^https://" }
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["kind", "label", "value", "source"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["status", "age", "trait", "habitat", "range"] },
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 },
              "source": {
                "type": "object",
                "required": ["label", "url"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "url": { "type": "string", "pattern": "^https://" }
                }
              }
            }
          }
        }
      }
    }
  }
}
