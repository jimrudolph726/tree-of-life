{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-life.example/schemas/journey-v1.json",
  "title": "Tree of Life editorial journey",
  "type": "object",
  "required": ["id", "category", "title", "subtitle", "duration", "introduction", "completion", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "category": { "type": "string", "minLength": 2 },
    "title": { "type": "string", "minLength": 10 },
    "subtitle": { "type": "string", "minLength": 40 },
    "duration": { "type": "string", "pattern": "^[0-9]+[–-][0-9]+ min$" },
    "introduction": { "type": "string", "minLength": 80 },
    "completion": {
      "type": "object",
      "required": ["title", "summary"],
      "properties": { "title": { "type": "string" }, "summary": { "type": "string" } }
    },
    "steps": {
      "type": "array", "minItems": 8, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["title", "taxon", "ottId", "age", "era", "kind", "summary", "evidence", "uncertainty", "image", "sources"],
        "properties": {
          "ottId": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["fossil evidence", "living lineage"] },
          "image": {
            "type": "object", "required": ["mediaId", "alt", "caption"],
            "properties": { "mediaId": { "type": "string" }, "alt": { "type": "string" }, "caption": { "type": "string" } }
          },
          "sources": {
            "type": "array", "minItems": 1,
            "items": { "type": "object", "required": ["label", "url"] }
          }
        }
      }
    }
  }
}
